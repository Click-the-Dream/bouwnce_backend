<mjml>
  <mj-body background-color="#f4f5f7">
    <mj-section background-color="#4f46e5" padding="24px 32px">
      <mj-text color="#ffffff" font-size="22px" font-weight="bold">
        {{ project_name }}
      </mj-text>
    </mj-section>
    <mj-section background-color="#ffffff" padding="32px">
      <mj-text font-size="20px" font-weight="bold" padding-bottom="8px">
        Your tickets are ready 🎟️
      </mj-text>
      <mj-text font-size="14px" line-height="20px" padding-bottom="16px">
        Hi {{ user_name }}, your purchase for <strong>{{ event_name }}</strong> is
        confirmed. Your ticket codes are below — present them at the venue for
        verification.
      </mj-text>
      <mj-text font-size="14px" color="#6b7280" padding-bottom="24px">
        {% if event_date %}Event date: {{ event_date }}{% endif %}
      </mj-text>
      {% for ticket in tickets %}
      <mj-wrapper border="1px solid #e5e7eb" border-radius="8px" padding-bottom="16px">
        <mj-text font-size="12px" color="#6b7280" padding-bottom="4px">
          {{ ticket.ticket_name }}
        </mj-text>
        <mj-text font-size="24px" letter-spacing="4px" font-weight="bold" padding-bottom="12px">
          {{ ticket.code }}
        </mj-text>
        {% if ticket.qr_code_url %}
        <mj-image src="{{ ticket.qr_code_url }}" alt="Ticket QR code" width="140px" />
        {% endif %}
      </mj-wrapper>
      {% endfor %}
      <mj-text font-size="13px" color="#6b7280" padding-top="8px">
        Keep this email safe — your ticket codes are required for entry.
      </mj-text>
    </mj-section>
    <mj-section background-color="#f9fafb" padding="16px 32px">
      <mj-text font-size="12px" color="#9ca3af">
        © {{ year }} {{ project_name }}. All rights reserved.
      </mj-text>
    </mj-section>
  </mj-body>
</mjml>
